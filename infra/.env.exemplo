# Sábado Premiado · senhas da instalação com Docker.
# Copie para ".env" (cp .env.exemplo .env) e troque os dois valores por textos gerados, por exemplo:
#   openssl rand -hex 24
# Use só letras e números (o comando acima já faz isso). Não envie este arquivo por e-mail nem coloque em repositório.
POSTGRES_PASSWORD=TROCAR_COM_openssl_rand_hex_24
AUTHENTICATOR_PASSWORD=TROCAR_COM_openssl_rand_hex_24
